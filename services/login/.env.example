# Servidor
LOGIN_HOST=0.0.0.0
LOGIN_PORT=5000
FLASK_DEBUG=False

# Clave de firma de la sesion de Flask.
# DEBE ser fija: si cambia entre reinicios, todas las sesiones se invalidan.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-generada
SESSION_LIFETIME_MINUTES=30

# JWT de acceso: login lo firma y el servicio de libros lo valida.
# JWT_SECRET y JWT_ALGORITHM deben ser IDENTICOS en services/books/.env.
# Minimo 32 bytes; sin ella el servicio no arranca. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-por-una-clave-generada
JWT_ALGORITHM=HS256
JWT_ISSUER=libreria-login

# PostgreSQL: misma base que el monolito Node.js
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library_db
DB_USER=login_app_user
DB_PASSWORD=cambiar-por-la-password-real

# Origenes permitidos para CORS con credenciales.
# No puede usarse '*' porque las peticiones viajan con cookie de sesion.
CORS_ORIGINS=http://localhost:5173,http://localhost:8123

# Verificar el registro MX del dominio al validar correos
VERIFY_EMAIL_MX=True

# --- Correo de verificacion (Postfix local) ---
MAIL_ENABLED=True
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USE_TLS=False
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@libreria.local

# SOLO en desarrollo local: escribe el token de verificacion en el log del
# servicio, para verificar cuentas sin un servidor de correo. Nunca en produccion.
MAIL_DEV_LOG_TOKEN=False

# URL publica usada para armar el enlace de verificacion del correo
PUBLIC_BASE_URL=http://localhost:5000

# Vigencia del token de verificacion, en horas
TOKEN_TTL_HOURS=24
