# Servidor
LOGIN_HOST=0.0.0.0
LOGIN_PORT=5000
FLASK_DEBUG=False

# --- Comun a los 6 microservicios (mismos valores en todos los .env) ---
# JWT: login lo firma; books, users, authors, pedidos y pagos lo validan.
# Minimo 32 bytes; sin ella el servicio no arranca. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambiar-por-una-clave-generada
JWT_ALGORITHM=HS256
JWT_ISSUER=libreria-login
ACCESS_TOKEN_MINUTES=20
# Redis compartido: sesiones, refresh tokens, revocacion y cache.
REDIS_URL=redis://:cambiar-por-la-password-de-redis@127.0.0.1:6379/0
REDIS_TIMEOUT_SECONDS=1.5
# Origenes de las aplicaciones cliente web permitidos por CORS (nunca '*').
CORS_ORIGINS=http://localhost:5173,http://localhost:8123

# --- Propio de login ---
# Sesion en Redis (session:<sid>) y refresh token: TTL deslizante.
SESSION_TTL_MINUTES=60
# True cuando el servicio se publique detras de HTTPS (nginx).
SESSION_COOKIE_SECURE=False

# PostgreSQL: misma base que el monolito Node.js
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library_db
DB_USER=login_app_user
DB_PASSWORD=cambiar-por-la-password-real

# Verificar el registro MX del dominio al validar correos
VERIFY_EMAIL_MX=True

# --- Correo de verificacion (Postfix local) ---
MAIL_ENABLED=True
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USE_TLS=False
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@libreria.local

# SOLO en desarrollo local: escribe el token de verificacion en el log del
# servicio, para verificar cuentas sin un servidor de correo. Nunca en produccion.
MAIL_DEV_LOG_TOKEN=False

# URL publica usada para armar el enlace de verificacion del correo
PUBLIC_BASE_URL=http://localhost:5000

# Vigencia del token de verificacion, en horas
TOKEN_TTL_HOURS=24
