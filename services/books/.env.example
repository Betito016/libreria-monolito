# Servidor
BOOKS_HOST=0.0.0.0
BOOKS_PORT=5001
FLASK_DEBUG=False

# PostgreSQL: catalogo de library.xml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=libreria_db
DB_USER=books_app_user
DB_PASSWORD=cambiar-por-la-password-real

# Microservicio de login (valida la sesion de quien escribe)
# En Windows usar 127.0.0.1: 'localhost' intenta primero ::1 y cada consulta al
# login tardaria ~2 s de mas (Flask escucha solo en IPv4).
LOGIN_SERVICE_URL=http://127.0.0.1:5000
LOGIN_SESSION_COOKIE_NAME=libreria_login_session
LOGIN_TIMEOUT_SECONDS=5
