# Servidor
BOOKS_HOST=0.0.0.0
BOOKS_PORT=5001
FLASK_DEBUG=False

# PostgreSQL: catalogo de library.xml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=libreria_db
DB_USER=books_app_user
DB_PASSWORD=cambiar-por-la-password-real

# JWT: las escrituras exigen "Authorization: Bearer <token>" emitido por login.
# JWT_SECRET, JWT_ALGORITHM y JWT_ISSUER deben ser IDENTICOS a los de
# services/login/.env: con otra clave, la firma de los tokens no valida.
JWT_SECRET=cambiar-por-la-misma-clave-que-login
JWT_ALGORITHM=HS256
JWT_ISSUER=libreria-login

# Microservicio de login: solo para /health (informa si se pueden emitir
# tokens nuevos). Las escrituras ya no le preguntan: validan el JWT localmente.
# En Windows usar 127.0.0.1: 'localhost' intenta primero ::1 y cada consulta
# tardaria ~2 s de mas (Flask escucha solo en IPv4).
LOGIN_SERVICE_URL=http://127.0.0.1:5000
LOGIN_TIMEOUT_SECONDS=5
