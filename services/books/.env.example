# Servidor
# Detrás del Library API Gateway: solo nginx (127.0.0.1) llega al servicio.
BOOKS_HOST=127.0.0.1
BOOKS_PORT=5001
FLASK_DEBUG=False

# PostgreSQL: catalogo de library.xml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=libreria_db
DB_USER=books_app_user
DB_PASSWORD=cambiar-por-la-password-real

# --- Comun a los 6 microservicios (mismos valores en todos los .env) ---
# Las escrituras exigen "Authorization: Bearer <token>" emitido por login.
JWT_SECRET_KEY=cambiar-por-la-misma-clave-que-login
JWT_ALGORITHM=HS256
JWT_ISSUER=libreria-login
ACCESS_TOKEN_MINUTES=20
# Redis compartido: revocacion (critica) y cache del catalogo (opcional).
REDIS_URL=redis://:cambiar-por-la-password-de-redis@127.0.0.1:6379/0
REDIS_TIMEOUT_SECONDS=1.5
CACHE_TTL_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8123

# Microservicio de login: solo para /health (informa si se pueden emitir
# tokens nuevos). En Windows usar 127.0.0.1: 'localhost' intenta primero ::1.
LOGIN_SERVICE_URL=http://127.0.0.1:5000
