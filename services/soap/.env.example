# Configuración del Servidor SOAP
# Detrás del Library API Gateway: solo nginx (127.0.0.1) llega al servicio.
SOAP_HOST=127.0.0.1
SOAP_PORT=5000
FLASK_DEBUG=True

# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=libreria_db
DB_USER=soap_app_user
DB_PASSWORD=cambiar-por-la-password-real

# Credenciales para WS-Security (UsernameToken)
WS_SECURITY_USER=admin_clasificador
WS_SECURITY_PASS=CloudSecure2026!
