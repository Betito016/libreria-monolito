# Servidor
LOGIN_HOST=0.0.0.0
LOGIN_PORT=5000
FLASK_DEBUG=False

# Clave de firma de la sesion de Flask.
# DEBE ser fija: si cambia entre reinicios, todas las sesiones se invalidan.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-generada
SESSION_LIFETIME_MINUTES=60

# PostgreSQL: misma base que el monolito Node.js
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library_db
DB_USER=login_app_user
DB_PASSWORD=cambiar-por-la-password-real

# Origenes permitidos para CORS con credenciales.
# No puede usarse '*' porque las peticiones viajan con cookie de sesion.
CORS_ORIGINS=http://localhost:5173,http://localhost:8123

# Verificar el registro MX del dominio al validar correos
VERIFY_EMAIL_MX=True
