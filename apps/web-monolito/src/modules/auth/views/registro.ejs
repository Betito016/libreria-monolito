<%- include(partialsDir + '/head', { titulo: 'Crear cuenta' }) %>
<%- include(partialsDir + '/header') %>
<main class="container angosto">
  <%- include(partialsDir + '/alerts') %>
  <h1>Crear cuenta</h1>
  <form method="POST" action="/registro" class="formulario">
    <label for="nombre">Nombre</label>
    <input id="nombre" type="text" name="nombre" required>
    <label for="email">Correo</label>
    <input id="email" type="email" name="email" required>
    <label for="password">Contraseña</label>
    <input id="password" type="password" name="password" required minlength="6">
    <label for="password2">Confirmar contraseña</label>
    <input id="password2" type="password" name="password2" required minlength="6">
    <button type="submit" class="btn">Crear cuenta</button>
  </form>
  <p class="nota">Las cuentas creadas aquí son de tipo cliente. El rol de administrador está limitado a un único usuario del sistema.</p>
</main>
<%- include(partialsDir + '/footer') %>
