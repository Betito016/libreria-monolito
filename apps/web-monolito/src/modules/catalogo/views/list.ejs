<%- include(partialsDir + '/head', { titulo: etiquetaPlural }) %>
<%- include(partialsDir + '/header') %>
<main class="container">
  <%- include(partialsDir + '/alerts') %>
  <div class="page-header">
    <h1><%= etiquetaPlural %></h1>
    <a class="btn" href="<%= base %>/nuevo">+ Nuevo <%= etiqueta %></a>
  </div>
  <table class="tabla">
    <thead><tr><th>#</th><th><%= etiqueta %></th><th></th></tr></thead>
    <tbody>
      <% items.forEach(function(item) { %>
        <tr>
          <td><%= item.id %></td>
          <td><%= item[columna] %></td>
          <td class="acciones">
            <a href="<%= base %>/<%= item.id %>/editar">Editar</a>
            <form action="<%= base %>/<%= item.id %>/eliminar" method="POST" onsubmit="return confirm('¿Eliminar este registro?');">
              <button type="submit" class="link-danger">Eliminar</button>
            </form>
          </td>
        </tr>
      <% }); %>
      <% if (items.length === 0) { %>
        <tr><td colspan="3">Sin registros todavía.</td></tr>
      <% } %>
    </tbody>
  </table>
</main>
<%- include(partialsDir + '/footer') %>
