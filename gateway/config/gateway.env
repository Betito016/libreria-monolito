# Configuración del servicio de salud agregada del gateway (RF5, RF9).
# Sin secretos: solo direcciones internas y tiempos. Se instala en
# /etc/library-gateway/gateway.env y lo lee library-gateway-salud.service.
#
# GW_INSTANCIAS: servicio=url[,url…] separados por ";". Cada URL es una instancia;
# la ruta de salud se agrega sola (SOAP no tiene /health: se comprueba con "/").
# Debe coincidir con los bloques "upstream" de nginx/library-gateway.conf.
GW_INSTANCIAS=login=http://127.0.0.1:5000;books=http://127.0.0.1:5001,http://127.0.0.1:6001;pagos=http://127.0.0.1:5002;pedidos=http://127.0.0.1:5003;users=http://127.0.0.1:5004;autores=http://127.0.0.1:5005;soap=http://127.0.0.1:5006
GW_RUTA_SALUD=/health?format=json
GW_RUTA_SALUD_SOAP=/
GW_TIMEOUT_SEGUNDOS=3
GW_SALUD_HOST=127.0.0.1
GW_SALUD_PUERTO=8090
